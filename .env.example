# Companion Satellite API (Companion > Settings > Satellite API)
COMPANION_HOST=127.0.0.1
COMPANION_PORT=16622

# --- USB drawing ---
# Milliseconds between USB image packets. Raise (1, 2, 5) if buttons look torn or half drawn.
HID_WRITE_DELAY_MS=0
# Bitmap size requested from Companion (72 or 112) and JPEG quality for keys / the touch strip (40-100).
# AKP05_IMAGE_SIZE=112
# AKP05_JPEG_QUALITY=75
# AKP05_STRIP_JPEG_QUALITY=75
# Black margin (px) between the strip edge and the outer icons. 0 = flush with the edge, aligned with the dials.
# AKP05_STRIP_EDGE_PADDING=0
# Wait this long (ms) to collect all four strip icons into one upload.
# AKP05_STRIP_BATCH_MS=20

# --- Input ---
# Synthetic key-up delay (ms) for touch zones, swipes and dial pushes.
# BRIDGE_AUTO_UP_MS=50
# Swap the swipe left/right assignment (1 = swap).
# BRIDGE_SWIPE_SWAP=0
# Repeat fast same-direction dial ticks N times (1 = off, max 10) within the window (ms).
# BRIDGE_ENCODER_ACCEL=1
# BRIDGE_ENCODER_ACCEL_WINDOW_MS=80
# Blank the displays after N minutes without input (0 = never).
# BRIDGE_IDLE_OFF_MINUTES=0

# --- Connection ---
# BRIDGE_KEEPALIVE_MS=1000
# BRIDGE_PING_INTERVAL_MS=1000
# BRIDGE_LINK_TIMEOUT_MS=10000
# BRIDGE_RECONNECT_MAX_MS=30000
# BRIDGE_HID_SCAN_MS=5000
# SATELLITE_HANDSHAKE_CRLF=0

# --- Logging ---
# LOG_LEVEL=info          # error | warn | info | debug (debug logs every frame and packet)
# LOG_DIR=                # defaults to the bridge folder
# LOG_MAX_BYTES=5242880
# LOG_BACKUPS=3
# BRIDGE_NO_TRAY=0
