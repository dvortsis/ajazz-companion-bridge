# Ajazz / Mirabox LCD decks: allow the logged-in user (uaccess) and the plugdev group to open them.
# Ajazz AKP05E
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0300", ATTRS{idProduct}=="3004", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0300", ATTRS{idProduct}=="3004", MODE="0660", GROUP="plugdev", TAG+="uaccess"
