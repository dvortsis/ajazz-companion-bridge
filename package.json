{
  "name": "ajazz-bridge",
  "version": "1.3.0",
  "description": "A background bridge connecting Ajazz and Mirabox macro pads to Bitfocus Companion.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:supervised": "node supervisor.js",
    "probe": "node index.js --probe",
    "test": "node --import ./test/setup.js --test \"test/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install-startup": "node startup.js install",
    "uninstall-startup": "node startup.js uninstall",
    "package": "node scripts/package.js",
    "udev": "node scripts/udev-rules.js"
  },
  "keywords": [
    "bitfocus-companion",
    "companion-satellite",
    "ajazz",
    "mirabox",
    "akp05",
    "stream-deck",
    "macro-pad"
  ],
  "author": "Benjamin Dvortsis",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.0",
    "node-hid": "^3.3.0",
    "sharp": "^0.34.5",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvortsis/ajazz-companion-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/dvortsis/ajazz-companion-bridge/issues"
  },
  "homepage": "https://github.com/dvortsis/ajazz-companion-bridge#readme"
}
